BR2_x86_64=y
BR2_GLOBAL_PATCH_DIR="board/qemu/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y

# Toolchain: fertige musl-Toolchain von Bootlin (spart den Toolchain-Build)
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_X86_64_MUSL_STABLE=y

# System
BR2_TARGET_GENERIC_HOSTNAME="arcadeos"
BR2_TARGET_GENERIC_ISSUE="ArcadeOS"
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ARCADEOS_PATH)/board/arcadeos/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_ARCADEOS_PATH)/board/arcadeos/post-build.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="$(BR2_EXTERNAL_ARCADEOS_PATH)"

# Kernel: eigene, schlanke Config (tinyconfig + board/arcadeos/linux-fragment.config)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.7"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_ARCADEOS_PATH)/board/arcadeos/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y

# SSH
BR2_PACKAGE_DROPBEAR=y

# Root-Dateisystem: read-only squashfs, Zustand auf eigener Partition (S00state)
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
# BR2_TARGET_ROOTFS_TAR is not set
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set

# Disk-Image (GPT: rootfs-a, rootfs-b, state)
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_E2FSPROGS=y
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_ARCADEOS_PATH)/board/arcadeos/post-image.sh"
