BR2_x86_64=y
BR2_GLOBAL_PATCH_DIR="board/qemu/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y

# Toolchain: fertige musl-Toolchain von Bootlin (spart den Toolchain-Build)
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_X86_64_MUSL_STABLE=y

# System
BR2_TARGET_GENERIC_HOSTNAME="arcadeos"
BR2_TARGET_GENERIC_ISSUE="ArcadeOS"
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ARCADEOS_PATH)/board/arcadeos/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_ARCADEOS_PATH)/board/arcadeos/post-build.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="$(BR2_EXTERNAL_ARCADEOS_PATH)"

# Kernel: eigene, schlanke Config (tinyconfig + board/arcadeos/linux-fragment.config)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.7"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_ARCADEOS_PATH)/board/arcadeos/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
# WLAN: Kernel prueft die Signatur der Regulierungsdatenbank (regulatory.db), braucht dafuer OpenSSL
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y

# busybox: zusaetzlich ntpd und tc
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ARCADEOS_PATH)/board/arcadeos/busybox.fragment"

# SSH
BR2_PACKAGE_DROPBEAR=y

# Signaturpruefung fuer Update-Pakete (Ed25519), Signieren auf der Build-Maschine
BR2_PACKAGE_MINISIGN=y
BR2_PACKAGE_HOST_MINISIGN=y

# Mesh-Dienst (Rust, br-external/package/meshd)
BR2_PACKAGE_HOST_RUSTC=y
BR2_PACKAGE_MESHD=y

# agentd (MCP-Server ueber SSH): Lua + JSON
BR2_PACKAGE_LUA=y
BR2_PACKAGE_LUA_5_4=y
BR2_PACKAGE_LUA_CJSON=y

# Root-Dateisystem: read-only squashfs, Zustand auf eigener Partition (S00state)
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
# BR2_TARGET_ROOTFS_TAR is not set
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set

# Bootloader: GRUB als UEFI-Programm und fuer alte PCs ohne UEFI (BIOS); beide lesen dieselbe
# grub.cfg, A/B-Auswahl ueber grubenv (board/arcadeos/grub.cfg)
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_GRUB2_BOOT_PARTITION="hd0,gpt2"
BR2_TARGET_GRUB2_BUILTIN_MODULES_PC="boot linux fat part_gpt part_msdos normal biosdisk loadenv test echo serial terminal"
BR2_TARGET_GRUB2_BUILTIN_CONFIG_PC="$(BR2_EXTERNAL_ARCADEOS_PATH)/board/arcadeos/grub-bios-embed.cfg"
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux fat part_gpt part_msdos normal loadenv test echo serial terminal efi_gop"

# Disk-Image (GPT: boot, rootfs-a, rootfs-b, state)
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_E2FSPROGS=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_ARCADEOS_PATH)/board/arcadeos/post-image.sh"
# Firmware fuer Netzwerkkarten, die ohne nicht laufen (Realtek PCIe und USB)
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_8169=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_815X=y
# WLAN: Qualcomm QCA9377 und Intel 8265 (beide als Option im ThinkPad E570), dazu weitere
# verbreitete Intel-Karten; Treiber sind Module (linux-fragment.config)
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_10K_QCA9377=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_8265=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_8000C=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_9XXX=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
# AP-Modus: fuer den QEMU-Test (ein simuliertes Funknetz) und spaeter fuer einen Einrichtungs-Hotspot
BR2_PACKAGE_WPA_SUPPLICANT_AP_SUPPORT=y
# Meldungen ins Syslog (/var/log/messages) - Fehlersuche auf echter Hardware
BR2_PACKAGE_WPA_SUPPLICANT_DEBUG_SYSLOG=y
