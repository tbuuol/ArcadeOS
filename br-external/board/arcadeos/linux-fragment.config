# ArcadeOS Kernel: Basis ist `make tinyconfig`, darauf kommt nur dieses Fragment.
# Neu erzeugen: board/arcadeos/gen-linux-config.sh
# Ziel: ein x86_64-Image fuer alle PCs, Laptops, Mini-PCs und VMs (QEMU/KVM, VirtualBox,
# Hyper-V, VMware). Alles fest eingebaut, keine Module. Kein Sound, kein WLAN (noch).

# --- Grundsystem ---
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_FILE_LOCKING=y
CONFIG_POSIX_TIMERS=y
CONFIG_SYSVIPC=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
# Kompression: Buildroot erzwingt ohnehin BR2_LINUX_KERNEL_GZIP, hier nur zur Klarheit
CONFIG_KERNEL_GZIP=y
CONFIG_PROC_SYSCTL=y
CONFIG_RD_XZ=n

# --- Hardware: PC/QEMU ---
CONFIG_PCI=y
CONFIG_ACPI=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# --- virtio ---
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_BLK_DEV=y

# --- UEFI: Kernel als EFI-Programm (GRUB/Firmware startet ihn) ---
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# --- Watchdog: startet ein haengendes System neu (wichtig fuer A/B-Rollback) ---
CONFIG_WATCHDOG=y
# QEMU
CONFIG_I6300ESB_WDT=y
# Intel- und AMD-Chipsaetze (echte PCs)
CONFIG_ITCO_WDT=y
CONFIG_SP5100_TCO=y

# --- Konsole: seriell (QEMU/Server) + Bildschirm ---
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
# Bildschirm: UEFI richtet vor dem Start ein Bild ein (GOP), egal ob VGA, DVI, HDMI oder
# DisplayPort. Der Kernel uebernimmt dieses Bild (efifb) - keine Grafiktreiber noetig.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
# grosse Schrift fuer hohe Aufloesungen (fbcon=font:TER16x32)
CONFIG_FONT_TER16x32=y
# Alte PCs ohne UEFI (BIOS-Start): VGA-Textmodus 80x25, kann jede PC-Grafikkarte
CONFIG_VGA_CONSOLE=y
# Hyper-V hat kein GOP-Bild im ueblichen Sinn, sondern eigenen Grafikbus
CONFIG_FB_HYPERV=y

# --- Speicher: USB-Sticks/-Platten, SATA (HDD/SSD), NVMe, SD-/eMMC ---
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y
CONFIG_ATA_PIIX=y
CONFIG_BLK_DEV_NVME=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_MMC_RICOH_MMC=y
# VMs: virtio-scsi (VirtualBox/Proxmox), VMware PVSCSI, Hyper-V
CONFIG_SCSI_VIRTIO=y
CONFIG_VMWARE_PVSCSI=y
CONFIG_HYPERV=y
CONFIG_HYPERV_STORAGE=y

# --- Netzwerkkarten (Kabel) ---
CONFIG_ETHERNET=y
# Intel: e1000 (alt, Standard in QEMU/VirtualBox), e1000e (die meisten PCs/Laptops), igb, igc (2.5G)
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
# Realtek r8169/r8125 (sehr viele Mainboards und Mini-PCs), braucht Firmware
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=y
CONFIG_NET_VENDOR_ATHEROS=y
CONFIG_ALX=y
CONFIG_ATL1C=y
# USB-Netzwerkadapter (Laptops ohne LAN-Buchse)
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_RTL8152=y
# VMs
CONFIG_VMXNET3=y
CONFIG_HYPERV_NET=y
# Firmware wird beim Oeffnen der Karte geladen (dann ist die Rootfs schon da)
CONFIG_FW_LOADER=y

# --- Dateisysteme ---
CONFIG_BLOCK=y
CONFIG_EXT4_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INOTIFY_USER=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=y
# FAT fuer die Boot-Partition (Kernel-Updates, grubenv)
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_SQUASHFS_ZSTD=y
# Partitionstabellen: GPT (PC/UEFI) und MBR (Raspberry Pi)
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

# --- Netzwerk ---
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_SYN_COOKIES=y
# Netztuning: BBR (fuellt Router-/Modempuffer nicht voll) + faire Warteschlangen,
# damit kleine Mesh-Nachrichten nicht hinter grossen Datenstroemen warten
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y

# --- Sicherheit ---
CONFIG_SECCOMP=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_CPU_MITIGATIONS=y
CONFIG_VMAP_STACK=y
CONFIG_MODULES=n
