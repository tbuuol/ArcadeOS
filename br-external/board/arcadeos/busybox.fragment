# Zeitsynchronisation (das Mesh braucht eine Uhr auf ~60 s genau)
CONFIG_NTPD=y
CONFIG_FEATURE_NTPD_SERVER=n
CONFIG_FEATURE_NTPD_CONF=n
# Warteschlangen anzeigen/steuern (Netztuning, Diagnose)
CONFIG_TC=y
CONFIG_FEATURE_TC_INGRESS=n
# WLAN ein-/ausschalten (rfkill) und DHCP-Server (QEMU-WLAN-Test, spaeter Einrichtungs-Hotspot)
CONFIG_RFKILL=y
CONFIG_UDHCPD=y
