# Zeitsynchronisation (das Mesh braucht eine Uhr auf ~60 s genau)
CONFIG_NTPD=y
CONFIG_FEATURE_NTPD_SERVER=n
CONFIG_FEATURE_NTPD_CONF=n
# Warteschlangen anzeigen/steuern (Netztuning, Diagnose)
CONFIG_TC=y
CONFIG_FEATURE_TC_INGRESS=n
# WLAN ein-/ausschalten (rfkill) und DHCP-Server (QEMU-WLAN-Test, spaeter Einrichtungs-Hotspot)
CONFIG_RFKILL=y
CONFIG_UDHCPD=y
# Monitoring-Seite: nur statische Dateien (kein CGI, keine Auth, kein Proxy), Rechte abgeben (-u)
CONFIG_HTTPD=y
CONFIG_FEATURE_HTTPD_PORT_DEFAULT=80
CONFIG_FEATURE_HTTPD_SETUID=y
CONFIG_FEATURE_HTTPD_GZIP=y
CONFIG_FEATURE_HTTPD_CGI=n
CONFIG_FEATURE_HTTPD_BASIC_AUTH=n
CONFIG_FEATURE_HTTPD_PROXY=n
# Uebliche Werkzeuge, die Agenten und fremde Programme (z.B. die Claude-App per SSH) erwarten
CONFIG_STAT=y
CONFIG_FEATURE_STAT_FORMAT=y
CONFIG_FEATURE_STAT_FILESYSTEM=y
CONFIG_TIMEOUT=y
CONFIG_PGREP=y
CONFIG_PKILL=y
CONFIG_PSTREE=y
CONFIG_COMM=y
CONFIG_SHUF=y
CONFIG_TAC=y
CONFIG_REV=y
CONFIG_SPLIT=y
CONFIG_EXPAND=y
CONFIG_UNEXPAND=y
CONFIG_SUM=y
CONFIG_FSYNC=y
CONFIG_BLOCKDEV=y
CONFIG_TASKSET=y
CONFIG_IONICE=y
CONFIG_BZIP2=y
CONFIG_NC=y
CONFIG_NC_EXTRA=y
CONFIG_UNICODE_SUPPORT=y
# wget mit HTTPS (eingebautes TLS)
CONFIG_TLS=y
CONFIG_SSL_CLIENT=y
CONFIG_FEATURE_WGET_HTTPS=y
