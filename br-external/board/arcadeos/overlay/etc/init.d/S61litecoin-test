#!/bin/sh
#
# Litecoin Core TESTNET (litecoind-test) als Dienst, sofern eingerichtet: /state/litecoin-test/litecoind (Startskript des Geraets,
# z.B. Litecoin-Testnet pruned fuer die tLTC-Zahlungen der LiteWorldsQuest-Beta:
# Programm, Datenverzeichnis, Nutzer; startet litecoind-test im Vordergrund und gibt 3 zurueck, wenn die Daten fehlen).
# Abschalten: Datei /state/litecoin-test/disabled anlegen. Ueberwachung und Neustart: /usr/lib/arcadeos/node-supervise.
# Beim Herunterfahren wird litecoind-test sauber beendet, bevor die Platten ausgehaengt werden (rcK stoppt rueckwaerts).
#

NAME=litecoin-test PROC=litecoind-test START=/state/litecoin-test/litecoind
STOP_WAIT=300   # Sekunden zum Schliessen der Datenbanken

start() {
	printf "Starting %s: " $NAME
	if [ ! -x $START ]; then echo "nicht eingerichtet ($START)"; return 0; fi
	if [ -f /state/$NAME/disabled ]; then echo "abgeschaltet (/state/$NAME/disabled)"; return 0; fi
	rm -f /run/$NAME.stop
	start-stop-daemon -S -b -m -p /run/$NAME-supervise.pid -x /usr/lib/arcadeos/node-supervise -- $NAME $START && echo "OK" || echo "FAIL"
}

stop() {
	printf "Stopping %s: " $NAME
	touch /run/$NAME.stop
	start-stop-daemon -K -q -p /run/$NAME-supervise.pid
	i=0
	while pidof $PROC >/dev/null && [ $i -lt $STOP_WAIT ]; do sleep 1; i=$((i + 1)); done
	if pidof $PROC >/dev/null; then killall -KILL $PROC 2>/dev/null; echo "nach ${STOP_WAIT}s hart beendet"; else echo "OK (${i}s)"; fi
}

case "$1" in
	start|stop) "$1";;
	restart|reload) stop; start;;
	*) echo "Usage: $0 {start|stop|restart|reload}"; exit 1;;
esac
