#!/bin/sh
#
# Dogecoin Core (dogecoind) als Dienst, sofern eingerichtet: /state/dogecoin/dogecoind (Startskript des Geraets,
# z.B. Dogecoin-Mainnet pruned als Merge-Mining-Ziel:
# Programm, Datenverzeichnis, Nutzer; startet dogecoind im Vordergrund und gibt 3 zurueck, wenn die Daten fehlen).
# Abschalten: Datei /state/dogecoin/disabled anlegen. Ueberwachung und Neustart: /usr/lib/arcadeos/node-supervise.
# Beim Herunterfahren (zuerst, alle Knoten gleichzeitig, rcK) wird dogecoind sauber beendet, bevor die Platten ausgehaengt werden (rcK stoppt rueckwaerts).
#

NAME=dogecoin PROC=dogecoind START=/state/dogecoin/dogecoind

start() {
	printf "Starting %s: " $NAME
	if [ ! -x $START ]; then echo "nicht eingerichtet ($START)"; return 0; fi
	if [ -f /state/$NAME/disabled ]; then echo "abgeschaltet (/state/$NAME/disabled)"; return 0; fi
	rm -f /run/$NAME.stop
	start-stop-daemon -S -b -m -p /run/$NAME-supervise.pid -x /usr/lib/arcadeos/node-supervise -- $NAME $START && echo "OK" || echo "FAIL"
}

stop() {
	printf "Stopping %s: " $NAME
	/usr/lib/arcadeos/node-stop $NAME $PROC
}

case "$1" in
	start|stop) "$1";;
	restart|reload) stop; start;;
	*) echo "Usage: $0 {start|stop|restart|reload}"; exit 1;;
esac
