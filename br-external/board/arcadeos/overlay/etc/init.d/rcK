#!/bin/sh
#
# Herunterfahren (ArcadeOS): zuerst alle Chain-Knoten (Startskripte mit node-supervise) GLEICHZEITIG sauber
# beenden, solange Monitor, Web und Netz noch laufen; danach die uebrigen Dienste in umgekehrter Reihenfolge.
# So schreibt jeder Knoten seine Datenbank zu Ende, statt am Ende einer langen Kette hart beendet zu werden,
# und die Monitor-Seite bleibt erreichbar, bis die Knoten zu sind.
#
nodes=""
for i in $(ls -r /etc/init.d/S??*); do
	[ -f "$i" ] || continue
	grep -q node-supervise "$i" 2>/dev/null && nodes="$nodes $i"
done

# 1. Knoten parallel stoppen und auf alle warten
for i in $nodes; do "$i" stop & done
wait

# 2. Der Rest wie bisher, rueckwaerts
for i in $(ls -r /etc/init.d/S??*); do
	[ -f "$i" ] || continue
	case " $nodes " in *" $i "*) continue;; esac
	case "$i" in
		*.sh)
			(
				trap - INT QUIT TSTP
				set stop
				# shellcheck source=/dev/null
				. "$i"
			)
			;;
		*)
			"$i" stop
			;;
	esac
done
