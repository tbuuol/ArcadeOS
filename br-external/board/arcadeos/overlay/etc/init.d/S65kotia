#!/bin/sh
#
# Kotia Core (kotiad) als Dienst, sofern eingerichtet: /state/kotia/kotiad (Startskript des Geraets:
# Programm, Datenverzeichnis, Nutzer; startet kotiad im Vordergrund und gibt 3 zurueck, wenn die Daten fehlen).
# Abschalten: Datei /state/kotia/disabled anlegen. Ueberwachung und Neustart: /usr/lib/arcadeos/kotia-supervise.
# Beim Herunterfahren wird kotiad sauber beendet, bevor die Platten ausgehaengt werden (rcK stoppt rueckwaerts).
#

STOP_WAIT=120   # Sekunden, die kotiad zum Schliessen seiner Datenbanken bekommt

start() {
	printf "Starting kotia: "
	if [ ! -x /state/kotia/kotiad ]; then echo "nicht eingerichtet (/state/kotia/kotiad)"; return 0; fi
	if [ -f /state/kotia/disabled ]; then echo "abgeschaltet (/state/kotia/disabled)"; return 0; fi
	rm -f /run/kotia.stop
	start-stop-daemon -S -b -m -p /run/kotia-supervise.pid -x /usr/lib/arcadeos/kotia-supervise && echo "OK" || echo "FAIL"
}

stop() {
	printf "Stopping kotia: "
	touch /run/kotia.stop
	start-stop-daemon -K -q -p /run/kotia-supervise.pid
	i=0
	while pidof kotiad >/dev/null && [ $i -lt $STOP_WAIT ]; do sleep 1; i=$((i + 1)); done
	if pidof kotiad >/dev/null; then killall -KILL kotiad 2>/dev/null; echo "nach ${STOP_WAIT}s hart beendet"; else echo "OK (${i}s)"; fi
}

case "$1" in
	start|stop) "$1";;
	restart|reload) stop; start;;
	*) echo "Usage: $0 {start|stop|restart|reload}"; exit 1;;
esac
