#!/bin/sh
#
# LiteWorldsQuest beta: das House (Spielserver, die einzige Autoritaet der Spielwelt), auf 127.0.0.1:8097,
# erreichbar ueber Caddy https://arcade.liteworlds.quest/lwq/ws (Anmeldung ueber das Arcade-Cookie).
# Startskript (geraetespezifisch): /state/lwq/lwq-house (Programm, Inhalte und Spielerdaten unter /state/lwq,
# laeuft als Nutzer 1020; Code 3 wenn die Inhalte fehlen). Ueberwachung und Neustart: /usr/lib/arcadeos/node-supervise.
# Beim Beenden speichert das House alle Spieler (SIGTERM). Abschalten: Datei /state/lwq/disabled anlegen.
#

NAME=lwq
START=/state/lwq/lwq-house

start() {
	printf "Starting $NAME: "
	[ -x $START ] || { echo "nicht eingerichtet ($START)"; return 0; }
	[ -f /state/lwq/disabled ] && { echo "abgeschaltet (/state/lwq/disabled)"; return 0; }
	rm -f /run/$NAME.stop
	start-stop-daemon -S -b -m -p /run/$NAME-supervise.pid -x /usr/lib/arcadeos/node-supervise -- $NAME $START && echo "OK" || echo "FAIL"
}

stop() {
	printf "Stopping $NAME: "
	touch /run/$NAME.stop
	start-stop-daemon -K -q -p /run/$NAME-supervise.pid
	i=0; while [ -f /run/$NAME-node.pid ] && kill -0 "$(cat /run/$NAME-node.pid)" 2>/dev/null && [ $i -lt 20 ]; do sleep 1; i=$((i + 1)); done
	rm -f /run/$NAME.stop
	echo "OK"
}

case "$1" in
	start|stop) "$1";;
	restart|reload) stop; start;;
	*) echo "Usage: $0 {start|stop|restart|reload}"; exit 1;;
esac
