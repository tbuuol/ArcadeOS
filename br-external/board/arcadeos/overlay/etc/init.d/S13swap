#!/bin/sh
#
# Auslagerung (Swap) als Ueberlauf fuer den RAM: Datei(en) aus /state/config/swap, eine Zeile je Datei:
#   <pfad> [swappiness]      z.B.  /state/swapfile 10
# Die Datei muss es schon geben (mkswap); angelegt oder formatiert wird hier nichts. Ohne Konfiguration: nichts.
# Beim Herunterfahren (rcK, rueckwaerts) wird sie vor dem Aushaengen von /state wieder abgeschaltet.
#

CONF=/state/config/swap

start() {
	printf "Starting swap: "
	[ -f $CONF ] || { echo "keine ($CONF)"; return 0; }
	n=0
	while read -r f sw _; do
		case "$f" in ''|\#*) continue;; esac
		[ -f "$f" ] || { echo -n "fehlt: $f "; continue; }
		grep -q "^$f " /proc/swaps || swapon "$f" && n=$((n + 1))
		[ -n "$sw" ] && echo "$sw" > /proc/sys/vm/swappiness
	done < $CONF
	echo "$n aktiv"
}

stop() {
	printf "Stopping swap: "
	[ -f $CONF ] || { echo "OK"; return 0; }
	while read -r f _; do
		case "$f" in ''|\#*) continue;; esac
		grep -q "^$f " /proc/swaps && swapoff "$f"
	done < $CONF
	echo "OK"
}

case "$1" in
	start|stop) "$1";;
	restart|reload) stop; start;;
	*) echo "Usage: $0 {start|stop|restart|reload}"; exit 1;;
esac
