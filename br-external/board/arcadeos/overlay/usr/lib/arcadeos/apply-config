#!/bin/sh
#
# Wendet /state/config an (aufgerufen von S10config beim Booten und von arcadeos-config live).
# Schreibt immer zuerst sichere Vorgaben (DHCP, Recovery-SSH-Keys aus dem Image) und legt die
# Konfiguration darueber – eine kaputte oder fehlende Konfiguration sperrt nie aus.
#
#   apply-config boot|live
#

. /usr/lib/arcadeos/common.sh

CFG=/state/config
R=/run/arcadeos
MODE=${1:-live}
mkdir -p $R

get() { sed -n "s/^$1=//p" "$CFG/system.conf" 2>/dev/null | tail -1; }

# Praefix (24) -> Netzmaske (255.255.255.0)
pfx2mask() {
	p=$1; m=""
	for i in 1 2 3 4; do
		if [ "$p" -ge 8 ]; then o=255; p=$((p - 8)); else o=$((256 - (1 << (8 - p)))); p=0; fi
		m="$m${m:+.}$o"
	done
	echo "$m"
}

# Beim Booten: unbestaetigte Aenderung vom letzten Lauf (Neustart waehrend der Frist) zuruecknehmen
if [ "$MODE" = boot ] && [ -f "$CFG/.pending" ] && [ -d /state/config.prev ]; then
	rm -rf "$CFG"; mv /state/config.prev "$CFG"; rm -f "$CFG/.pending"; sync
	audit config-rollback "Neustart waehrend der Frist"
	echo "Konfiguration: unbestaetigte Aenderung zurueckgenommen"
fi

# 1. SSH-Keys: Recovery-Keys aus dem Image immer, dann die vom Stick, dann die aus der Konfiguration.
#    Stick: Datei authorized_keys (oder authorized_keys.txt) in der FAT-Partition "boot" - die laesst
#    sich an jedem Windows-/Mac-/Linux-Rechner oeffnen. Wer den Stick in der Hand hat, besitzt das
#    Geraet ohnehin. Gelesen nur beim Booten (Windows-Zeilenenden und BOM werden entfernt).
if [ "$MODE" = boot ]; then
	: > $R/boot_keys
	dev=$(find_part boot)
	if [ -n "$dev" ]; then
		mkdir -p $R/bootfs
		if mount -t vfat -o ro,nodev,nosuid,noexec "/dev/$dev" $R/bootfs 2>/dev/null; then
			bom=$(printf '\357\273\277')
			for f in authorized_keys authorized_keys.txt; do
				[ -f "$R/bootfs/$f" ] && tr -d '\r' < "$R/bootfs/$f" | sed "1s/^$bom//" >> $R/boot_keys
			done
			umount $R/bootfs
		fi
	fi
	n=$(grep -cE '^(ssh-|ecdsa-|sk-)' $R/boot_keys)
	[ "$n" -gt 0 ] && { echo "SSH-Keys vom Stick: $n"; audit boot-keys "$n Key(s) aus boot/authorized_keys"; }
fi
{
	cat /etc/arcadeos/recovery_keys
	grep -E '^(ssh-|ecdsa-|sk-)' $R/boot_keys 2>/dev/null || true
	grep -E '^(ssh-|ecdsa-)' "$CFG/authorized_keys" 2>/dev/null || true
} > $R/authorized_keys.new
chmod 600 $R/authorized_keys.new
mv $R/authorized_keys.new $R/authorized_keys

# 2. Hostname
h=$(get hostname)
[ -n "$h" ] && hostname "$h"

# 3. Netzwerk: neue Datei erzeugen; nur wenn sie sich unterscheidet, mit der alten Datei abbauen,
#    dann die neue aktivieren (eine reine Hostname-Aenderung soll die Verbindung nicht kappen)
# Kabel-Netzwerkkarten (mit Geraet dahinter: kein lo/sit/tun); keine gefunden -> eth0
nics() {
	n=""
	for d in /sys/class/net/*; do [ -e "$d/device" ] && n="$n ${d##*/}"; done
	echo "${n:- eth0}"
}
{
	printf 'auto lo\niface lo inet loopback\n'
	if [ "$(get net.mode)" = static ] && [ -n "$(get net.address)" ] && [ -n "$(get net.gateway)" ]; then
		# feste Adresse auf einer Karte (net.interface, sonst die erste)
		i=$(get net.interface)
		[ -n "$i" ] || { set -- $(nics); i=$1; }
		a=$(get net.address)
		printf '\nauto %s\niface %s inet static\n\taddress %s\n\tnetmask %s\n\tgateway %s\n' \
			"$i" "$i" "${a%/*}" "$(pfx2mask "${a#*/}")" "$(get net.gateway)"
		STATIC=1
	else
		# DHCP auf jeder Karte: auf einem echten PC weiss niemand vorher, welche Buchse belegt ist
		for i in $(nics); do printf '\nauto %s\niface %s inet dhcp\n' "$i" "$i"; done
		STATIC=0
	fi
} > $R/interfaces.new
NETCHANGE=1
cmp -s $R/interfaces.new $R/interfaces 2>/dev/null && NETCHANGE=0
[ "$MODE" = live ] && [ "$NETCHANGE" = 1 ] && ifdown -a -f >/dev/null 2>&1
mv $R/interfaces.new $R/interfaces
mkdir -p /run/udhcpc
if [ "$STATIC" = 1 ]; then
	rm -f /run/udhcpc/*
	for d in $(get net.dns); do echo "nameserver $d"; done > /run/udhcpc/static
	cat /run/udhcpc/* > /etc/resolv.conf 2>/dev/null || true
else
	rm -f /run/udhcpc/static
fi
[ "$MODE" = live ] && [ "$NETCHANGE" = 1 ] && ifup -a >/dev/null 2>&1

# 4. NTP-Server; live nur bei Aenderung ntpd neu starten
get ntp.servers > $R/ntp.servers.new
if ! cmp -s $R/ntp.servers.new $R/ntp.servers 2>/dev/null; then
	mv $R/ntp.servers.new $R/ntp.servers
	[ "$MODE" = live ] && /etc/init.d/S48ntpd restart >/dev/null 2>&1
else
	rm -f $R/ntp.servers.new
fi
exit 0
