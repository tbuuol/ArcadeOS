#!/bin/sh
# Haelt Kotia Core (kotiad) am Laufen: Start im Vordergrund ueber /state/kotia/kotiad (geraetespezifisches
# Startskript: Programm, Daten, Nutzer), nach einem Absturz Neustart nach 30 s. Meldet das Startskript
# Code 3 (Daten fehlen, z.B. Platte nicht eingebunden), wird es alle 60 s erneut versucht.
# SIGTERM (vom Init-Skript): kotiad sauber beenden (schliesst seine Datenbanken), darauf warten, dann enden.
# Kurze Meldungen gehen ins Syslog (logger -t kotia); kotiad schreibt selbst debug.log in sein Datenverzeichnis.

. /usr/lib/arcadeos/common.sh

START=/state/kotia/kotiad
child=""
stop() {
	[ -n "$child" ] && kill -TERM "$child" 2>/dev/null
	# kotiad braucht beim Beenden je nach Datenmenge einige Sekunden; das Init-Skript wartet ebenfalls
	[ -n "$child" ] && wait "$child" 2>/dev/null
	exit 0
}
trap stop TERM INT
# Beim Booten erst aufs Netz warten (hoechstens 60 s): ohne nicht-lokale Adresse laesst glibc (AI_ADDRCONFIG) selbst
# das Binden von RPC an 127.0.0.1 scheitern, kotiad beendet sich dann sofort.
i=0
while ! ip route 2>/dev/null | grep -q '^default' && [ $i -lt 60 ]; do sleep 1; i=$((i + 1)); done
last=""
while :; do
	"$START" -printtoconsole=0 </dev/null >/dev/null 2>&1 &
	child=$!
	echo "$child" > /run/kotiad.pid
	wait "$child"
	rc=$?
	child=""
	rm -f /run/kotiad.pid
	[ -f /run/kotia.stop ] && exit 0
	if [ $rc = 3 ]; then
		[ "$last" = 3 ] || { logger -t kotia "Daten fehlen (Platte nicht eingebunden?), neuer Versuch alle 60 s"; audit kotia-wait "Daten fehlen"; }
		last=3
		sleep 60
	else
		logger -t kotia "kotiad beendet (Code $rc), Neustart in 30 s"
		audit kotia-restart "Code $rc"
		last=$rc
		sleep 30
	fi
done
