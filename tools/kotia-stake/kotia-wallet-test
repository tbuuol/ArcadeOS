#!/bin/sh
# Test (2026-11-16): chaind with the Kotia wallet module (kotia_wallet.rs) beside kotiad, to compare the wallet RPCs.
# Its own data (fresh sync), RPC 127.0.0.1:44893, NO staking. Stop: kill the chaind-kotw process. Remove: rm -r its dir.
D=/state/chaind-data/kotia-wtest
export CHAIND_CHAIN=kotia CHAIND_DIR=$D CHAIND_RPC=127.0.0.1:44893 MALLOC_ARENA_MAX=2 \
	CHAIND_PEERS="127.0.0.1:46174" CHAIND_KOTIA_WALLET=/state/chaind/kotia-stake.keys
R=/usr/lib/arcadeos/runas; [ -x $R ] || R=/state/kotia/runas
exec nice -n 19 $R 1010 1010 /state/chaind/bin/chaind-kotw >> $D/chaind.log 2>&1
